{
  "name": "shreeji-complex-backend",
  "version": "1.0.0",
  "description": "Flat Maintenance System backend (with Tailwind build and Brevo email support)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "vite build",
    "dev:server": "cross-env NODE_OPTIONS=--no-warnings nodemon server.js",
    "dev:vite": "vite",
    "dev": "concurrently --raw \"npm:dev:server\" \"npm:dev:vite\""
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.6",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.395.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3"
  },
  "keywords": [
    "express",
    "tailwindcss",
    "render-deployment",
    "nodemailer",
    "brevo",
    "flat-maintenance-system"
  ],
  "author": "Kush Amit Shah",
  "license": "MIT"
}
